# ==============================================================================
# TerraGuard AI - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in your backend directory or workspace root:
#    cp .env.example .env
# 2. Add your Google Gemini API key below.
# 3. Never commit your real '.env' file with secret keys to version control.
# ==============================================================================

# Google Gemini API Key (Required for live Gemini explainable reasoning and multilingual alert dispatch)
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Google Gemini Model
# Defaults to gemini-2.5-flash for speed and grounded reasoning.
# Supported options: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Optional: Continuous Landslide Catalog Sync Interval (seconds)
# Default is 180 seconds for hackathon judging demo-ability.
TERRAGUARD_SCHEDULER_INTERVAL=180

# Optional: Application Server Ports
PORT=8000
HOST=127.0.0.1
